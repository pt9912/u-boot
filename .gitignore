# Build artefacts
/out/
/dist/
/coverage/
/bin/
*.test
*.out

# Stray Go binaries from local `go build` runs (the canonical build
# path is `make build` into the runtime image; local binaries should
# never be checked in).
/uboot
/u-boot

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Agent / tooling working dirs
.claude/*
!.claude/agents/
!.claude/rules/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json

# Gate-Nachweis (record-gates), pro Klon
/.harness/state/
.codex/
.agents/

# Vendored Regelwerk-Baseline unter .harness/baseline/ ist COMMITTET
# (harness/conventions/MR-004, MR-007); nur ephemere Harness-Nebenprodukte
# ignorieren. Aktuell defensiv / No-op: fetch-baseline-cache.sh nutzt mktemp,
# nicht .harness/cache/.
.harness/cache/

# Local env overrides (if ever added — never commit secrets)
.env
.env.local

# Linux-Pakete (scripts/build-packages.sh)
/packages/

# Go build, test and module cache of the devcontainer (GOCACHE, GOMODCACHE under the workspace)
/.cache/
