# BEGIN U-BOOT MANAGED BLOCK: init
# Devcontainer image for u-boot — generated by `u-boot generate devcontainer`.
FROM mcr.microsoft.com/devcontainers/base:debian

# Non-root default user.
USER root
# Nested Docker daemon: packages from the Docker APT repository
# (the key file must hold exactly the pinned primary key), daemon started at
# container start.
RUN install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && test "$(gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | awk -F: '/^pub/ {p=1} /^sub/ {p=0} /^fpr/ && p {print $10}')" = "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin iptables ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && usermod -aG docker vscode
COPY docker-init.sh /usr/local/bin/u-boot-docker-init
# Ollama: the CPU-only release archive of ollama/ollama.
# Version and checksums are pinned here, in one place; the build stops before
# the extraction unless the SHA-256 matches. The upstream publishes no
# signature: the check catches a release asset that was swapped later, not a
# release that was harmful from the start. The GPU libraries stay out of the
# image; `zstd` is installed for the extraction and removed in the same step.
# The image starts no server and sets no listen address. The model store
# belongs to the container user, so the named volume mounted there inherits
# that ownership.
ARG OLLAMA_VERSION=0.40.6
ARG OLLAMA_SHA256_AMD64=c164ab8b1b28e2a247c29719b8e404c423c5b83ae64c3ab4e59d50c7ff7fc5e0
ARG OLLAMA_SHA256_ARM64=0a279d9428ad17b06fdb7dddf3b059b2c148433585fa3b30676a102fc459bb9f
RUN apt-get update \
 && apt-get install -y --no-install-recommends zstd \
 && rm -rf /var/lib/apt/lists/* \
 && arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${OLLAMA_SHA256_AMD64}" ;; arm64) sha256="${OLLAMA_SHA256_ARM64}" ;; *) echo "ollama has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-${arch}.tar.zst" \
 && echo "${sha256}  ollama-linux-${arch}.tar.zst" | sha256sum -c - \
 && tar --zstd -xf "ollama-linux-${arch}.tar.zst" -C /usr/local --no-same-owner --exclude='lib/ollama/cuda_*' --exclude='lib/ollama/vulkan' \
 && cd / \
 && rm -rf "$work" \
 && apt-get purge -y --auto-remove zstd \
 && mkdir -p /home/vscode/.ollama \
 && chown vscode:vscode /home/vscode/.ollama
# GitHub CLI: the release archive of cli/cli, only bin/gh is
# extracted. Version and checksums are pinned here, in one place; the build
# stops before the extraction unless the SHA-256 matches. The check catches a
# release asset that was swapped later, not a release that was harmful from
# the start: no signature was found for the archive (by search pattern, not
# exhaustive), and the GitHub attestation the project publishes is not
# verified. The image stores no token and runs no `gh auth login`.
ARG GH_VERSION=2.103.0
ARG GH_SHA256_AMD64=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786
ARG GH_SHA256_ARM64=7f322df34e624d14f5ec0c4acb121fd6dfa14392fdbbd1066aa8e0a05ac3721e
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${GH_SHA256_AMD64}" ;; arm64) sha256="${GH_SHA256_ARM64}" ;; *) echo "gh has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
 && echo "${sha256}  gh_${GH_VERSION}_linux_${arch}.tar.gz" | sha256sum -c - \
 && tar -xzf "gh_${GH_VERSION}_linux_${arch}.tar.gz" -C /usr/local --strip-components=1 --no-same-owner "gh_${GH_VERSION}_linux_${arch}/bin/gh" \
 && cd / \
 && rm -rf "$work"
# Go toolchain: the release archive of go.dev/dl (the same origin as the
# download). Version and checksums stand here as build arguments and in one
# place; a `version:` override of the project replaces the value and both
# checksums together, read for the chosen version from the download listing,
# so the check stays a check against the official source. The build stops
# before the extraction unless the SHA-256 matches. The archive is not signed
# and the build verifies no signature: the check catches a file replaced
# later, not a release that was harmful from the start.
ARG GO_VERSION=1.27.3
ARG GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${GO_SHA256_AMD64}" ;; arm64) sha256="${GO_SHA256_ARM64}" ;; *) echo "go has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" \
 && echo "${sha256}  go${GO_VERSION}.linux-${arch}.tar.gz" | sha256sum -c - \
 && tar -xzf "go${GO_VERSION}.linux-${arch}.tar.gz" -C /usr/local \
 && cd / \
 && rm -rf "$work"
ENV PATH="/usr/local/go/bin:${PATH}"
# golangci-lint: the release archive of golangci/golangci-lint, only the
# program golangci-lint is extracted. Version and checksums stand here as
# build arguments and in one place; a `version:` override of the project
# replaces the value and both checksums together, read for the chosen version
# from the checksums file of that release. The build stops before the
# extraction unless the SHA-256 matches. The archive is not signed and the
# build verifies no signature: the check catches a file replaced later, not a
# release that was harmful from the start.
ARG GOLANGCI_LINT_VERSION=v2.14.0
ARG GOLANGCI_LINT_SHA256_AMD64=ab90aeb7b066f92a33415b638a50fe5344bbb75a0d32ad30cc248d88f81032ab
ARG GOLANGCI_LINT_SHA256_ARM64=ee7ec5f3453d15ddf106fae5a4d6c71737712348a979d1fe9cd52ec7ea299bae
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${GOLANGCI_LINT_SHA256_AMD64}" ;; arm64) sha256="${GOLANGCI_LINT_SHA256_ARM64}" ;; *) echo "golangci-lint has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-${arch}.tar.gz" \
 && echo "${sha256}  golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-${arch}.tar.gz" | sha256sum -c - \
 && tar -xzf "golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-${arch}.tar.gz" --strip-components=1 -C /usr/local/bin "golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-${arch}/golangci-lint" \
 && cd / \
 && rm -rf "$work"
# Status files of the container start scripts; `u-boot doctor`
# reads them from the host. The directory belongs to the container user so the
# `postCreateCommand` and the `sudo` scripts can write there.
RUN mkdir -p /var/lib/u-boot/status && chown vscode:vscode /var/lib/u-boot/status
# Sandbox profile: workspace lives in a named volume that
# inherits ownership from this directory.
RUN mkdir -p "/workspaces/u-boot" && chown vscode:vscode "/workspaces/u-boot"
# Git credentials come from $GIT_TOKEN at runtime; nothing is stored in the image.
RUN git config --system credential.helper '!f() { test -n "$GIT_TOKEN" && printf "username=x-access-token\npassword=%s\n" "$GIT_TOKEN"; }; f'
USER vscode
# END U-BOOT MANAGED BLOCK: init

# ---- Hand-written rest (behind the managed block) ---------------------------
# `u-boot generate devcontainer` leaves the lines below untouched. The two
# toolchain keys `go-toolchain` and `golangci-lint` carry the installations
# and the cache directories of the managed block and the `containerEnv` of
# the generated devcontainer.json; the keys set none of these three values,
# so they stand here, in the hand-written rest: BUILD_MODE=local selects the
# local mode of repo.mk, GOFLAGS and GOTOOLCHAIN mirror the stage `deps` of
# the root Dockerfile and the official Go images (GOTOOLCHAIN=local: Go never
# fetches another toolchain).
ENV BUILD_MODE=local \
    GOFLAGS="-mod=readonly -buildvcs=false" \
    GOTOOLCHAIN=local
