# BEGIN U-BOOT MANAGED BLOCK: init
# Devcontainer image for {{.Name}} — generated by `u-boot generate devcontainer`.
FROM mcr.microsoft.com/devcontainers/base:debian

# Non-root default user (LH-FA-DEV-004).
{{- if or .UID .Sandbox .Gh .Glab}}
USER root
{{- if .UID}}
ARG USER_UID={{.UID}}
RUN usermod --uid "${USER_UID}" vscode \
 && groupmod --gid "${USER_UID}" vscode \
 && chown -R "${USER_UID}:${USER_UID}" /home/vscode
{{- end}}
{{- if .NestedPodman}}
# Nested rootless Podman (LH-FA-DEV-007): the static release archive of
# mgoltzsche/podman-static (Podman, crun, conmon, netavark, aardvark-dns,
# passt, fuse-overlayfs). Version, checksums and signing key are pinned here,
# in one place; the build stops before the extraction unless the SHA-256 and a
# signature of the pinned primary key match. `uidmap` keeps the setuid
# newuidmap/newgidmap from Debian.
ARG PODMAN_VERSION=6.1.4
ARG PODMAN_SHA256_AMD64=9dd51073fac5a1742f88cf3caff5554615cb4d67ba554d25e8807be635547af5
ARG PODMAN_SHA256_ARM64=c106d09d7524209ce01eb3a02a7e621e9c55ec31d0fada48439cf77aa07afdb6
ARG PODMAN_SIGNING_KEY=0CCF102C4F95D89E583FF1D4F8B5AF50344BB503
RUN apt-get update \
 && apt-get install -y --no-install-recommends uidmap ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${PODMAN_SHA256_AMD64}" ;; arm64) sha256="${PODMAN_SHA256_ARM64}" ;; *) echo "podman-static has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && url="https://github.com/mgoltzsche/podman-static/releases/download/v${PODMAN_VERSION}/podman-linux-${arch}.tar.gz" \
 && curl -fsSLO "$url" \
 && curl -fsSLO "$url.asc" \
 && echo "${sha256}  podman-linux-${arch}.tar.gz" | sha256sum -c - \
 && curl -fsSL "https://keys.openpgp.org/vks/v1/by-fingerprint/${PODMAN_SIGNING_KEY}" -o key.asc \
 && export GNUPGHOME="$work/gnupg" \
 && install -d -m 0700 "$GNUPGHOME" \
 && gpg --batch --import key.asc \
 && status="$(gpg --batch --status-fd 1 --verify "podman-linux-${arch}.tar.gz.asc" "podman-linux-${arch}.tar.gz")" \
 && test "$(echo "$status" | awk '$2 == "VALIDSIG" {print $12}')" = "${PODMAN_SIGNING_KEY}" \
 && tar -xzf "podman-linux-${arch}.tar.gz" -C / --strip-components=1 --no-same-owner \
 && cd / \
 && rm -rf "$work" /README.md \
 && printf "unqualified-search-registries = ['docker.io']\n" > /etc/containers/registries.conf \
 && ln -sf /usr/local/bin/podman /usr/local/bin/docker \
 && (grep -q '^vscode:' /etc/subuid || echo 'vscode:100000:65536' >> /etc/subuid) \
 && (grep -q '^vscode:' /etc/subgid || echo 'vscode:100000:65536' >> /etc/subgid) \
 && mkdir -p /home/vscode/.local/share/containers \
 && chown -R vscode:vscode /home/vscode/.local
COPY sandbox-init.sh /usr/local/bin/u-boot-sandbox-init
{{- end}}
{{- if .NestedDocker}}
# Nested Docker daemon (LH-FA-DEV-007): packages from the Docker APT repository
# (the key file must hold exactly the pinned primary key), daemon started at
# container start.
RUN install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && test "$(gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | awk -F: '/^pub/ {p=1} /^sub/ {p=0} /^fpr/ && p {print $10}')" = "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin iptables ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && usermod -aG docker vscode
COPY docker-init.sh /usr/local/bin/u-boot-docker-init
{{- end}}
{{- if .Ollama}}
# Ollama (LH-FA-DEV-003): the CPU-only release archive of ollama/ollama.
# Version and checksums are pinned here, in one place; the build stops before
# the extraction unless the SHA-256 matches. The upstream publishes no
# signature: the check catches a release asset that was swapped later, not a
# release that was harmful from the start. The GPU libraries stay out of the
# image; `zstd` is installed for the extraction and removed in the same step.
# The image starts no server and sets no listen address. The model store
# belongs to the container user, so the named volume mounted there inherits
# that ownership.
ARG OLLAMA_VERSION=0.40.6
ARG OLLAMA_SHA256_AMD64=c164ab8b1b28e2a247c29719b8e404c423c5b83ae64c3ab4e59d50c7ff7fc5e0
ARG OLLAMA_SHA256_ARM64=0a279d9428ad17b06fdb7dddf3b059b2c148433585fa3b30676a102fc459bb9f
RUN apt-get update \
 && apt-get install -y --no-install-recommends zstd \
 && rm -rf /var/lib/apt/lists/* \
 && arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${OLLAMA_SHA256_AMD64}" ;; arm64) sha256="${OLLAMA_SHA256_ARM64}" ;; *) echo "ollama has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-${arch}.tar.zst" \
 && echo "${sha256}  ollama-linux-${arch}.tar.zst" | sha256sum -c - \
 && tar --zstd -xf "ollama-linux-${arch}.tar.zst" -C /usr/local --no-same-owner --exclude='lib/ollama/cuda_*' --exclude='lib/ollama/vulkan' \
 && cd / \
 && rm -rf "$work" \
 && apt-get purge -y --auto-remove zstd \
 && mkdir -p /home/vscode/.ollama \
 && chown vscode:vscode /home/vscode/.ollama
{{- end}}
{{- if .Gh}}
# GitHub CLI (LH-FA-DEV-003): the release archive of cli/cli, only bin/gh is
# extracted. Version and checksums are pinned here, in one place; the build
# stops before the extraction unless the SHA-256 matches. The check catches a
# release asset that was swapped later, not a release that was harmful from
# the start: no signature was found for the archive (by search pattern, not
# exhaustive), and the GitHub attestation the project publishes is not
# verified. The image stores no token and runs no `gh auth login`.
ARG GH_VERSION=2.103.0
ARG GH_SHA256_AMD64=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786
ARG GH_SHA256_ARM64=7f322df34e624d14f5ec0c4acb121fd6dfa14392fdbbd1066aa8e0a05ac3721e
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${GH_SHA256_AMD64}" ;; arm64) sha256="${GH_SHA256_ARM64}" ;; *) echo "gh has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
 && echo "${sha256}  gh_${GH_VERSION}_linux_${arch}.tar.gz" | sha256sum -c - \
 && tar -xzf "gh_${GH_VERSION}_linux_${arch}.tar.gz" -C /usr/local --strip-components=1 --no-same-owner "gh_${GH_VERSION}_linux_${arch}/bin/gh" \
 && cd / \
 && rm -rf "$work"
{{- end}}
{{- if .Glab}}
# GitLab CLI (LH-FA-DEV-003): the release archive of gitlab-org/cli, only
# bin/glab is extracted. Version and checksums are pinned here, in one place;
# the build stops before the extraction unless the SHA-256 matches. The check
# catches a release asset that was swapped later, not a release that was
# harmful from the start: no signature was found for the archive (by search
# pattern, not exhaustive). The image stores no token and runs no
# `glab auth login`.
ARG GLAB_VERSION=1.124.0
ARG GLAB_SHA256_AMD64=63df684842b0697e418649dd64374d37ac1da0fbcdcb422d6a5557222f8bb40f
ARG GLAB_SHA256_ARM64=0716395a0efeb991fc844b33fe55310645afcbd9b9746e50c725e9d1cd1b8d16
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sha256="${GLAB_SHA256_AMD64}" ;; arm64) sha256="${GLAB_SHA256_ARM64}" ;; *) echo "glab has no archive for $arch" >&2; exit 1 ;; esac \
 && work="$(mktemp -d)" \
 && cd "$work" \
 && curl -fsSLO "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_${arch}.tar.gz" \
 && echo "${sha256}  glab_${GLAB_VERSION}_linux_${arch}.tar.gz" | sha256sum -c - \
 && tar -xzf "glab_${GLAB_VERSION}_linux_${arch}.tar.gz" -C /usr/local --no-same-owner bin/glab \
 && cd / \
 && rm -rf "$work"
{{- end}}
{{- if .Egress}}
# Egress restriction (LH-FA-DEV-008).
RUN apt-get update \
 && apt-get install -y --no-install-recommends dnsmasq-base nftables \
 && rm -rf /var/lib/apt/lists/*
COPY egress-init.sh /usr/local/bin/u-boot-egress-init
{{- end}}
{{- if or .NestedPodman .NestedDocker .Egress}}
# Status files of the container start scripts (LH-FA-DEV-007); `u-boot doctor`
# reads them from the host. The directory belongs to the container user so the
# `postCreateCommand` and the `sudo` scripts can write there.
RUN mkdir -p /var/lib/u-boot/status && chown vscode:vscode /var/lib/u-boot/status
{{- end}}
{{- if .Sandbox}}
# Sandbox profile (LH-FA-DEV-006): workspace lives in a named volume that
# inherits ownership from this directory.
RUN mkdir -p "{{.WorkspaceFolder}}" && chown vscode:vscode "{{.WorkspaceFolder}}"
# Git credentials come from $GIT_TOKEN at runtime (LH-FA-DEV-009); nothing is stored in the image.
RUN git config --system credential.helper '!f() { test -n "$GIT_TOKEN" && printf "username=x-access-token\npassword=%s\n" "$GIT_TOKEN"; }; f'
{{- end}}
{{- end}}
USER vscode
# END U-BOOT MANAGED BLOCK: init
