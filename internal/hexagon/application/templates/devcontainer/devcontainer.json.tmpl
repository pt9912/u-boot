// BEGIN U-BOOT MANAGED BLOCK: init
{
  "name": "{{.Name}}",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."{{if .UID}},
    "args": {
      "USER_UID": "{{.UID}}"
    }{{end}}
  },
{{- if .Sandbox}}
  "workspaceMount": "",
  "workspaceFolder": "{{.WorkspaceFolder}}",
{{- if .RunArgs}}
  "runArgs": [{{range $i, $a := .RunArgs}}{{if $i}}, {{end}}"{{$a}}"{{end}}],
{{- end}}
{{- if eq (len .Mounts) 1}}
  "mounts": ["{{index .Mounts 0}}"],
{{- else}}
  "mounts": [
{{- range $i, $m := .Mounts}}
{{- if $i}},{{end}}
    "{{$m}}"
{{- end}}
  ],
{{- end}}
{{- if .PostCreate}}
  "postCreateCommand": "{{.PostCreate}}",
{{- end}}
{{- if .PostStart}}
  "postStartCommand": "{{.PostStart}}",
{{- end}}
  "remoteEnv": {
    "GIT_TOKEN": "${localEnv:GIT_TOKEN}"
{{- range .AgentEnv}},
    "{{.}}": "${localEnv:{{.}}}"
{{- end}}
  },
{{- else if .RunArgs}}
  "runArgs": [{{range $i, $a := .RunArgs}}{{if $i}}, {{end}}"{{$a}}"{{end}}],
{{- end}}
{{- $goKeys := or .GoToolchain .GolangciLint}}
{{- if or $goKeys .ContainerEnv}}
  "containerEnv": {
{{- if $goKeys}}
    "GOCACHE": "${containerWorkspaceFolder}/.cache/go-build",
    "GOMODCACHE": "${containerWorkspaceFolder}/.cache/go-mod"
{{- end}}
{{- range $i, $e := .ContainerEnv}}
{{- if $goKeys}},{{else if $i}},{{end}}
    "{{$e.Name}}": "{{$e.Value}}"
{{- end}}
  },
{{- end}}{{- /* kein containerEnv-Wert für java-toolchain: JAVA_HOME/PATH stehen im Block (SPEC-054); die Projekt-Werte von devcontainer.containerEnv kommen als sortierte Einträge hinzu (lastenheft 0.32.0) */ -}}
{{- if .ForwardPorts}}
  "forwardPorts": [{{range $i, $p := .ForwardPorts}}{{if $i}}, {{end}}{{$p}}{{end}}],
{{- end}}
{{- if .Features}}
  "features": {
{{- range $i, $f := .Features}}
{{- if $i}},{{end}}
    "{{$f.Source}}:{{$f.Version}}": {}
{{- end}}
  },
{{- end}}
  "remoteUser": "vscode"
}
// END U-BOOT MANAGED BLOCK: init
