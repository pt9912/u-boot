# Messwerkzeug fuer A9: Dev-Container-CLI (npm) mit Docker-CLI; spricht ueber den Docker-Socket mit dem Daemon des Messhosts.
# Kein Teil des Produkts; das Image heisst u-boot-messung-amd64-devcontainer-cli.
# Gepinnt: beide Basis-Images per Digest, die CLI per Version (0.89.0 ist die gemessene). Nicht gepinnt: die npm-Abhaengigkeiten der CLI
# (npm loest sie beim Bau auf) und die Debian-Pakete des Node-Images.
FROM docker:29-cli@sha256:6fae2214c3121a28d5aa639d09032f61310b7c9c75ffbad1025f261a1b621800 AS dockercli
FROM node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
RUN npm install -g @devcontainers/cli@0.89.0
